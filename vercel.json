{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.js",
      "headers": [ { "key": "Content-Type", "value": "text/javascript; charset=utf-8" } ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [ { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" } ]
    },
    {
      "source": "/",
      "headers": [ { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" } ]
    }
  ]
}
